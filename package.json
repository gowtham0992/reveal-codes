{
  "name": "reveal-codes",
  "version": "0.0.0",
  "private": true,
  "description": "Drafting editor for court filings that records the provenance of every character and verifies every legal citation.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:pbt": "FC_NUM_RUNS=500 vitest run --passWithNoTests properties.test",
    "dev": "pnpm --filter @reveal-codes/web dev",
    "mcp": "pnpm --filter @reveal-codes/courtlistener-mcp start",
    "sentinel": "pnpm --filter @reveal-codes/sentinel run cli",
    "kiro:check": "node scripts/kiro-usage-check.mjs",
    "power:build": "node scripts/build-power.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
