# Which LLM provider the assistant uses: bedrock (default) or anthropic.
LLM_PROVIDER=bedrock
# AWS region for Amazon Bedrock; only read when LLM_PROVIDER=bedrock.
AWS_REGION=
# Anthropic API key; only read when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Optional CourtListener API token; without it the verifier runs at a lower rate limit.
COURTLISTENER_TOKEN=
