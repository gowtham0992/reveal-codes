# CourtListener API token. Required for live lookups; without it the app runs in demo mode on recorded responses.
# Never sent to the browser. Read by the MCP server and the web app.
COURTLISTENER_TOKEN=
# Base URL of the CourtListener REST API. Optional; default https://www.courtlistener.com/api/rest/v4.
COURTLISTENER_BASE_URL=
# Directory of the verifier's on-disk cache in live mode. Optional; default ~/.reveal-codes/cache.
REVEAL_CODES_CACHE_DIR=
# When 1, serve every request from recorded fixtures and make no network call, even if a token is set. Optional; default unset.
REVEAL_CODES_FIXTURES_ONLY=
# AWS region for Amazon Bedrock. Selects Bedrock for the assistant only together with BEDROCK_MODEL_ID; both are required as a pair.
AWS_REGION=
# Amazon Bedrock model id for the assistant. Required together with AWS_REGION; there is no default.
BEDROCK_MODEL_ID=
# ARN of an IAM role for Bedrock. When set, the app assumes it with the host's OIDC token instead of using stored keys. Optional; not a secret, never sent to the browser.
BEDROCK_ROLE_ARN=
# AWS access key id for Bedrock when BEDROCK_ROLE_ARN is not used. Read by the AWS SDK; prefer the platform's own credentials or a role.
AWS_ACCESS_KEY_ID=
# AWS secret access key, paired with AWS_ACCESS_KEY_ID. Never commit it; set it in the host's settings.
AWS_SECRET_ACCESS_KEY=
# Anthropic API key for the assistant. Used when Bedrock is not configured; required together with ANTHROPIC_MODEL.
ANTHROPIC_API_KEY=
# Anthropic model id for the assistant. Required together with ANTHROPIC_API_KEY; there is no default.
ANTHROPIC_MODEL=
# Address of the two-minute demo video. Optional; public, read when the app is built. When set, the small-screen page links to it as "Watch the two-minute demo". http or https only.
NEXT_PUBLIC_VIDEO_URL=
# Address of the source repository. Optional; public, read when the app is built. When set, the small-screen page links to it as "Source code", and the Courts_Page (`/courts`) uses it for its links to the dataset and its README. http or https only.
NEXT_PUBLIC_REPO_URL=
