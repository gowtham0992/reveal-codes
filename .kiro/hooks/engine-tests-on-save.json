{
  "version": "v1",
  "hooks": [
    {
      "name": "Engine tests on save",
      "trigger": "PostFileSave",
      "matcher": "packages/engine/(src|test)/.*\\.ts$",
      "timeout": 120,
      "action": {
        "type": "command",
        "command": "perl -e 'alarm shift; exec @ARGV' 120 pnpm vitest run --project engine --passWithNoTests"
      }
    }
  ]
}
