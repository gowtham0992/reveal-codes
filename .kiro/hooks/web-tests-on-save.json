{
  "version": "v1",
  "hooks": [
    {
      "name": "Web tests on save",
      "trigger": "PostFileSave",
      "matcher": "apps/web/(src|test)/.*\\.tsx?$",
      "timeout": 120,
      "action": {
        "type": "command",
        "command": "perl -e 'alarm shift; exec @ARGV' 120 pnpm vitest run --project web --passWithNoTests"
      }
    }
  ]
}
