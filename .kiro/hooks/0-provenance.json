{
  "version": "v1",
  "hooks": [
    {
      "name": "Provenance: prompt",
      "trigger": "UserPromptSubmit",
      "timeout": 30,
      "enabled": true,
      "action": {
        "type": "command",
        "command": "node .kiro/provenance/provenance.mjs record promptSubmit >/dev/null 2>&1 || true"
      }
    },
    {
      "name": "Provenance: stop",
      "trigger": "Stop",
      "timeout": 30,
      "enabled": true,
      "action": {
        "type": "command",
        "command": "node .kiro/provenance/provenance.mjs record agentStop >/dev/null 2>&1 || true"
      }
    },
    {
      "name": "Provenance: task start",
      "trigger": "PreTaskExec",
      "timeout": 30,
      "enabled": true,
      "action": {
        "type": "command",
        "command": "node .kiro/provenance/provenance.mjs record preTask >/dev/null 2>&1 || true"
      }
    },
    {
      "name": "Provenance: task end",
      "trigger": "PostTaskExec",
      "timeout": 30,
      "enabled": true,
      "action": {
        "type": "command",
        "command": "node .kiro/provenance/provenance.mjs record postTask >/dev/null 2>&1 || true"
      }
    }
  ]
}
