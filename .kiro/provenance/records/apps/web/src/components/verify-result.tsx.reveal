[DOC{v=1;n=0}][PST{t=2026-11-20T03:04:47Z}]import type { Document } from "@reveal-codes/engine";
import { summaryLines } from "../client/verify-summary";
import styles from "./verify-result.module.css";

export type VerifyResultProps = Readonly<{
  document: Document;
  verifiedAt: string | null;
  further: string | null;
[HUM{t=2026-11-22T00:50:56.432Z}]  now: () => Date;
[PST{t=2026-11-20T03:04:47Z}]  /** The sentence for a failed run; nothing else in the region changes. */
  failure?: string | null;
}>;

/** The Verify_Summary: always rendered, empty until a Verify has completed. */
export function VerifyResult({[HUM{t=2026-11-22T00:50:56.432Z}]
  document,
  verifiedAt,
  further,
  now,
  failure = null,
}: VerifyResultProps) {
  const summary = verifiedAt === null ? \[\] : summaryLines(document, verifiedAt, further, now()[PST{t=2026-11-20T03:04:47Z}]);
  const lines = failure === null ? summary : \[failure, ...summary\];
  return (
    <div role="status" aria-label="Verify result" className={styles\["result"\]}>
      {lines.map((text) => (
        <p key={text} className={styles\["line"\]}>
          {text}
        </p>
      ))}
    </div>
  );
}
