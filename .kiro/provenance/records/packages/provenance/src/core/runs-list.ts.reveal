[DOC{v=1;n=0;r=10.6 Runs list tag once\, one version source\, setup names each file 2026-11-21T06:05:01Z.1,273,0,0;r=7.11 Short run tags\, "Runs in this file"\, `--full` 2026-11-20T05:24:08Z.1,2203,0,0;r=7.14 Runs list without repeated number\, no redundant tags sentence\, a blank pane line 2026-11-20T16:17:27Z.1,101,0,0;r=7.14 Runs list without repeated number\, no redundant tags sentence\, a blank pane line 2026-11-20T16:17:27Z.2,51,0,0}][AI:7.11 Short run tags, "Runs in this file", `--full` 2026-11-20T05:24:08Z.1{t=2026-11-20T05:35:16.652Z}]/**
 * The "Runs in this file" list of `reveal <file>` (Req 9.15; design, Runs in this file).
 * Pure; no `node:`. Titles come from the file's Record, so they are neutralized (M6) and, in plain
 * output, escaped like text. Columns are padded by the width of the unescaped title, so the
 * plain and the coloured list differ only by the escapes (Property 6).
 */
import { neutralize } from "./neutralize.js";
import type { WindowTag } from "./tags.js";

/** The heading of the list. */
export const RUNS_HEADING = "Runs in this file";

const INDENT = "  ";
const width = (text: string): number => Array.from(text).length;
const escapeText = (text: string): string => text.replace(/\[\\\\\[\\\]\]/gu, "\\\\$&");

[AI:7.14 Runs list without repeated number, no redundant tags sentence, a blank pane line 2026-11-20T16:17:27Z.1{t=2026-11-20T16:21:52.951Z}]/**[AI:10.6 Runs list tag once, one version source, setup names each file 2026-11-21T06:05:01Z.1{t=2026-11-21T06:11:28.053Z}]
 * The title without the Task_Number: the tag in the first column already carries it. Left out
 * (an empty cell) when it equals the tag, so a prompt window prints `turn` once (Req 9.15).
 */
function description(w: WindowTag): string {
  if (w.title === w.tag) return "";[AI:7.11 Short run tags, "Runs in this file", `--full` 2026-11-20T05:24:08Z.1{t=2026-11-20T05:35:16.652Z}]
  [AI:7.14 Runs list without repeated number, no redundant tags sentence, a blank pane line 2026-11-20T16:17:27Z.2{t=2026-11-20T16:21:52.951Z}]return neutralize(w.title).replace(/\[\\n\\t\]/gu, " ")[AI:7.11 Short run tags, "Runs in this file", `--full` 2026-11-20T05:24:08Z.1{t=2026-11-20T05:35:16.652Z}];
}

function hunkWords(n: number): string {
  return `${String(n)} ${n === 1 ? "hunk" : "hunks"}`;
}

/** The heading and one line for each window, in the order given; titles escaped when `escape`. */
export function runsListLines(windows: readonly WindowTag\[\], escape: boolean): string\[\] {
  const descs = windows.map(description);
  const opened = windows.map((w) => `opened ${w.time ?? "?"}`);
  const hunks = windows.map((w) => hunkWords(w.hunks));
  const widest = (cells: readonly string\[\]): number => Math.max(0, ...cells.map(width));
  const \[tagW, descW, openedW, hunkW\] = \[
    widest(windows.map((w) => w.tag)),
    widest(descs),
    widest(opened),
    widest(hunks),
  \];
  const lines = windows.map((w, i) => {
    const desc = descs\[i\] ?? "";
    const shown = escape ? escapeText(desc) : desc;
    const tag = w.tag + " ".repeat(tagW - width(w.tag));
    const gap = " ".repeat(descW - width(desc));
    const open = (opened\[i\] ?? "") + " ".repeat(openedW - width(opened\[i\] ?? ""));
    const count = " ".repeat(hunkW - width(hunks\[i\] ?? "")) + (hunks\[i\] ?? "");
    return `${INDENT}${tag}  ${shown}${gap}  ${open}  ${count}`;
  });
  return \[RUNS_HEADING, ...lines\];
}
