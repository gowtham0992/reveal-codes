[AI:7.10 Summary order, file filter, `--all`, aligned columns, no repeated titles 2026-11-20T05:17:25Z.9{t=2026-11-20T05:24:04.007Z}]/** Summarize the Records and Unchanged_Files under `input.path` (Req 10.1 to 10.18[AI:7.5 `summary.ts` 2026-11-20T04:03:24Z.1{t=2026-11-20T04:07:25.429Z}]). */
export function summarize(input: SummaryInput): SummaryResult {
  if (input.records.length === 0 && input.unchanged.length === 0) {
    return { status: 1, lines: \[NOTHING_RECORDED\], text: NOTHING_RECORDED, summary: null };
  }
  const scope = normalizePath(input.path);
  const records = input.records.filter((r) => under(r.path, scope));
  const unchanged = input.unchanged.filter((u) => under(u.path, scope));
  const summary =
    records.length + unchanged.length === 0
      ? null
      : buildSummary(records, unchanged, input.top ?? DEFAULT_TOP[AI:7.10 Summary order, file filter, `--all`, aligned columns, no repeated titles 2026-11-20T05:17:25Z.10{t=2026-11-20T05:24:04.007Z}], input.all === true[AI:7.5 `summary.ts` 2026-11-20T04:03:24Z.1{t=2026-11-20T04:07:25.429Z}]);
  const lines =
    summary === null
      ? \[`Nothing recorded under ${scope ?? ""}.`, ...sessionsLines(input.sessions)\]
      : renderSummary(summary, input.sessions);
  return { status: 0, lines, text: lines.join("\\n"), summary };
}
