}
/**
 * `provenance record <name>`. `cwd` is the process working directory. `onLog` is called once the
 * Fault_Log exists, so the entry module can log an exception that escapes. Returns without output
 * when there is no Record_Directory. Throws only what the dependencies throw.
 */
export async function runRecord(
  deps: Deps,
  name: string,
  cwd: string,
  onLog: (logger: Logger) => void = () => undefined,
): Promise<void> {
  const event = parseEvent(name);
  const raw = event === null || event === "manual" ? "" : await readStdin(deps);
  const payload = parsePayload(raw);
  const root = await findWorkspaceRoot(deps, cwd, payload.cwd);
  if (root === null) return;
  const store = createStore(deps, `${root}/.kiro/provenance`);
  const logger = createFaultLog(deps, `${store.dir}/errors.log`);
  onLog(logger);
  const live: Deps = { ...deps, log: logger };
  if (event === null) {
    await logger.fault({ event: "unknown", path: null, reason: "unknown_event" });
    return;
  }
  await recordInRoot({ deps: live, root, store, event, payload });
}
