export async function findWorkspaceRoot(
  deps: Pick<Deps, "fs">,
  cwd: string,
  payloadCwd: string | null,
): Promise<string | null> {
  for (let dir: string | null = normalizeDir(cwd); dir !== null; dir = parentOf(dir)) {
