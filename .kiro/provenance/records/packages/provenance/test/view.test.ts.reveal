[DOC{v=1;n=2;r=7.11 Short run tags\, "Runs in this file"\, `--full` 2026-11-20T05:24:08Z.1,3,0,0;r=7.11 Short run tags\, "Runs in this file"\, `--full` 2026-11-20T05:24:08Z.2,32,0,0;r=7.11 Short run tags\, "Runs in this file"\, `--full` 2026-11-20T05:24:08Z.3,76,0,0;r=7.11 Short run tags\, "Runs in this file"\, `--full` 2026-11-20T05:24:08Z.4,3747,0,0;r=7.3 `palette.ts`\, `neutralize.ts` and `view.ts` 2026-11-20T03:57:41Z.1,5127,0,0}][AI:7.3 `palette.ts`, `neutralize.ts` and `view.ts` 2026-11-20T03:57:41Z.1{t=2026-11-20T04:03:18.620Z}]import { createDocument } from "@reveal-codes/engine";
import type { Document } from "@reveal-codes/engine";
import { describe, expect, it } from "vitest";
import { legendLines } from "../src/core/legend.js";
import { viewRecord, type ViewMode } from "../src/core/view.js";
const AT = "2026-11-19T10:00:00Z";
const RUN = "1 Probe task one 2026-11-19T10:00:00Z.2";
// eslint-disable-next-line no-control-regex
const ANSI = /\\u001b\\\[\[0-9;\]*m/g;
function pst(text: string): Document {
  const made = createDocument(text, AT);
  if (!made.ok) throw new Error(made.error.kind);
  return made.value;
}
/** A document of three spans: HUM, AI, AI>HUM. */
function mixed(text: string): Document {
  const third = Math.floor(text.length / 3);
  const doc = pst(text);
  const prov = (origin: "HUM" | "AI" | "AI>HUM"): Document\["spans"\]\[number\]\["provenance"\] =>
    origin === "HUM" ? { origin, timestamp: AT } : { origin, runId: RUN, timestamp: AT };
  return {
    ...doc,
    spans: \[
      { start: 0, end: third, provenance: prov("HUM") },
      { start: third, end: 2 * third, provenance: prov("AI") },
      { start: 2 * third, end: text.length, provenance: prov("AI>HUM") },
    \],
  };
}
const MODES: ViewMode\[\] = \["truecolor", "ansi256", "plain"\];
describe("viewRecord (Req 9)", () => {
  it("prints the header naming the file, then the four legend lines, then the body", () => {
    const lines = viewRecord(pst("x\\n"), "plain", "src/a.ts").split("\\n");
    expect(lines\[0\]).toBe("Reveal Codes: src/a.ts");
    expect(lines.slice(1, 5)).toEqual(legendLines());
    expect(lines\[5\]).toMatch(/^\\\[PST\\\]x$/);
  });
  it("prints an Unchanged_File as one \[PST\] code and its text", () => {
    const out = viewRecord(pst("one\\ntwo\\n"), "plain", "f.txt");
    expect(out.endsWith("\[PST\]one\\ntwo\\n")).toBe(true);
    expect(out.match(/\\\[PST\\\]/g)?.length).toBe(1 + 1); // the legend item and the code
  });
  it("escapes backslash and brackets in plain mode only", () => {
    const doc = pst("a\[b\]c\\\\d");
    expect(viewRecord(doc, "plain", "f").endsWith("\[PST\]a\\\\\[b\\\\\]c\\\\\\\\d")).toBe(true);
    for (const mode of \["truecolor", "ansi256"\] as const) {
      expect(viewRecord(doc, mode, "f").replace(ANSI, "").endsWith("\[PST\]a\[b\]c\\\\d")).toBe(true);
    }
  });
  it("prints no escape sequence from the file in any mode", () => {
    const doc = pst("x\\u001b\[31my\\rz\\u0085\\u007f");
    for (const mode of MODES) {
      const out = viewRecord(doc, mode, "f");
      expect(out.replace(ANSI, "")).not.toContain("\\u001b");
      const bracket = mode === "plain" ? "\\\\\[" : "\[";
      expect(out).toContain(`x\\u241b${bracket}31my\\u240dz\\ufffd\\u2421`);
    }
    expect(viewRecord(doc, "plain", "f")).not.toContain("\\u001b");
  });
  it("keeps tab and line feed", () => {
    expect(viewRecord(pst("a\\tb\\nc"), "plain", "f").endsWith("a\\tb\\nc")).toBe(true);
  });
  it("names the control characters of a file name too", () => {
    expect(viewRecord(pst("x"), "plain", "a\\u001bb").split("\\n")\[0\]).toBe("Reveal Codes: a\\u241bb");
  });
  it("prints no citation, quote, reference, override or document code for citation-like text", () => {
    const text = 'See Roe v. Wade, [CIT …{k=k0}]410 U.S. 113 (1973)[/CIT] ("[QUO …{k=k1}]the right[/QUO]"), [REF]42 U.S.C. § 1983[/REF].';
    for (const mode of MODES) {
      const out = viewRecord(pst(text), mode, "f").replace(ANSI, "");
      expect(out).not.toMatch(/\\\[\\/?(CIT|QUO|REF|OVR|DOC)/);
    }
  });
  it("prints the codes of AI and AI>HUM spans with their [AI:7.11 Short run tags, "Runs in this file", `--full` 2026-11-20T05:24:08Z.1{t=2026-11-20T05:35:16.652Z}]tag[AI:7.3 `palette.ts`, `neutralize.ts` and `view.ts` 2026-11-20T03:57:41Z.1{t=2026-11-20T04:03:18.620Z}], and the colours of the pane", () => {
    const doc = mixed("aaabbbccc");
    const plain = viewRecord(doc, "plain", "f");
    expect(plain.endsWith([AI:7.11 Short run tags, "Runs in this file", `--full` 2026-11-20T05:24:08Z.2{t=2026-11-20T05:35:16.652Z}]"\[HUM\]aaa\[AI:1\]bbb\[AI>HUM:1\]ccc"[AI:7.3 `palette.ts`, `neutralize.ts` and `view.ts` 2026-11-20T03:57:41Z.1{t=2026-11-20T04:03:18.620Z}])).toBe(true);
    const colour = viewRecord(doc, "truecolor", "f");
    expect(colour).toContain("\\u001b\[38;2;232;236;246m\\u001b\[48;2;15;39;102m\[HUM\]aaa");
    expect(colour).toContain("\\u001b\[38;2;166;212;247m\\u001b\[48;2;15;39;102m\[AI:");
    expect(colour).toContain("\\u001b\[38;2;215;198;245m\\u001b\[48;2;15;39;102m\[AI>HUM:");
    expect(viewRecord(doc, "ansi256", "f")).toContain("\\u001b\[48;5;17m");
  });
  it("ends every coloured line with a reset", () => {
    const out = viewRecord(mixed("ab\\ncd\\nef\\ngh\\n"), "truecolor", "f");
    for (const line of out.split("\\n").slice(0, -1)) expect(line.endsWith("\\u001b\[0m")).toBe(true);
    expect(out.endsWith("\\u001b\[0m")).toBe(true);
  });
  it("unescaping the text of the plain view gives the coloured view without ANSI (Req 9.8)", () => {
    const doc = mixed("a\[x\]\\\\y\\u001bz\\nq\[");
    const head = (s: string): string => s.split("\\n").slice(0, [AI:7.11 Short run tags, "Runs in this file", `--full` 2026-11-20T05:24:08Z.3{t=2026-11-20T05:35:16.652Z}]8).join("\\n");
    const body = (s: string): string => s.split("\\n").slice(8[AI:7.3 `palette.ts`, `neutralize.ts` and `view.ts` 2026-11-20T03:57:41Z.1{t=2026-11-20T04:03:18.620Z}]).join("\\n");
    const plain = viewRecord(doc, "plain", "f");
    const unescapedBody = body(plain).replace(/\\\\(\[\\s\\S\])/g, "$1");
    for (const mode of \["truecolor", "ansi256"\] as const) {
      const stripped = viewRecord(doc, mode, "f").replace(ANSI, "");
      expect(head(stripped)).toBe(head(plain));
      expect(body(stripped)).toBe(unescapedBody);
    }
    expect(body(plain)).toContain("a\\\\\[x");
    expect(body(plain)).toContain("\\\\\]\\\\\\\\y");
    expect(body(plain)).toContain("\\u241bz[AI:7.11 Short run tags, "Runs in this file", `--full` 2026-11-20T05:24:08Z.4{t=2026-11-20T05:35:16.652Z}]");
  });
  it("prints the full Run_Id inline with --full, the <run> legend and no list", () => {
    const doc = mixed("aaabbbccc");
    const plain = viewRecord(doc, "plain", "f", true);
    expect(plain.endsWith(`\[HUM\]aaa\[AI:${RUN}\]bbb\[AI>HUM:${RUN}\]ccc`)).toBe(true);
    expect(plain.split("\\n").slice(1, 5)).toEqual(legendLines("run"));
    expect(plain).not.toContain("Runs in this file");
    expect(plain).not.toContain("Tags are listed");
    expect(plain.split("\\n")).toHaveLength(6);
  });
});

/** An AI span of `text` in the window `windowRun`, hunk `n`. */
function agent(
  windowRun: string,
  n: number,
  start: number,
  end: number,
): Document\["spans"\]\[number\] {
  const runId = `${windowRun}.${String(n)}`;
  return { start, end, provenance: { origin: "AI", runId, timestamp: AT } };
}
function withSpans(text: string, spans: Document\["spans"\]): Document {
  return { ...pst(text), spans };
}
const W66 = "6.6 Wire it 2026-11-19T10:00:00Z";
const W66B = "6.6 Wire it again 2026-11-19T10:05:00Z";
const TURN = "turn 2026-11-19T10:01:00Z";
const BARE = "task 2026-11-19T10:02:00Z";

describe("run tags and the Runs list (Req 9.14, 9.15)", () => {
  it("tags a numbered window, a prompt window and a window with no number", () => {
    const doc = withSpans("aabbcc", \[
      agent(W66, 1, 0, 2),
      agent(TURN, 1, 2, 4),
      agent(BARE, 1, 4, 6),
    \]);
    const lines = viewRecord(doc, "plain", "f").split("\\n");
    expect(lines.slice(-1)\[0\]).toBe("\[AI:6.6\]aa\[AI:turn\]bb\[AI:task\]cc");
    expect(lines\[5\]).toBe('Tags are listed under "Runs in this file".');
    expect(lines\[6\]).toBe("Runs in this file");
    expect(lines.slice(7, 10)).toEqual(\[
      "  6.6   6.6 Wire it  opened 2026-11-19T10:00:00Z  1 hunk",
      "  turn  turn         opened 2026-11-19T10:01:00Z  1 hunk",
      "  task  task         opened 2026-11-19T10:02:00Z  1 hunk",
    \]);
  });
  it("suffixes only a clash: two windows of one Task_Number give 6.6 and 6.6~2", () => {
    const doc = withSpans("aabbcc", \[
      agent(W66B, 1, 0, 2),
      agent(W66, 1, 2, 4),
      agent(TURN, 1, 4, 6),
    \]);
    const plain = viewRecord(doc, "plain", "f");
    expect(plain.endsWith("\[AI:6.6~2\]aa\[AI:6.6\]bb\[AI:turn\]cc")).toBe(true);
  });
  it("gives the hunks of one window one tag and counts them", () => {
    const doc = withSpans("aabbcc", \[
      agent(W66, 1, 0, 2),
      agent(W66, 2, 2, 4),
      agent(W66, 1, 4, 6),
    \]);
    const plain = viewRecord(doc, "plain", "f");
    expect(plain.endsWith("\[AI:6.6\]aa\[AI:6.6\]bb\[AI:6.6\]cc")).toBe(true);
    expect(plain).toContain("  6.6  6.6 Wire it  opened 2026-11-19T10:00:00Z  2 hunks\\n");
  });
  it("prints no list and no tags sentence for a file with no agent span", () => {
    const plain = viewRecord(pst("x"), "plain", "f");
    expect(plain).not.toContain("Runs in this file");
    expect(plain.split("\\n")).toHaveLength(6);
  });
  it("escapes \[ \] and \\\\ in a title in plain output only, with the same padding", () => {
    const window = "7 A\[b\]\\\\c 2026-11-19T10:00:00Z";
    const doc = withSpans("aa", \[agent(window, 1, 0, 2)\]);
    const plain = viewRecord(doc, "plain", "f").split("\\n");
    const colour = viewRecord(doc, "truecolor", "f").replace(ANSI, "").split("\\n");
    expect(plain\[7\]).toBe("  7  7 A\\\\\[b\\\\\]\\\\\\\\c  opened 2026-11-19T10:00:00Z  1 hunk");
    expect(colour\[7\]).toBe("  7  7 A\[b\]\\\\c  opened 2026-11-19T10:00:00Z  1 hunk");
    expect(plain\[7\]?.replace(/\\\\(\[\\s\\S\])/g, "$1")).toBe(colour\[7\]);
  });
  it("prints the list in colour output in the legend colour", () => {
    const doc = withSpans("aa", \[agent(W66, 1, 0, 2)\]);
    const colour = viewRecord(doc, "truecolor", "f");
    expect(colour).toContain("\\u001b\[48;2;15;39;102mRuns in this file\\u001b\[0m[AI:7.3 `palette.ts`, `neutralize.ts` and `view.ts` 2026-11-20T03:57:41Z.1{t=2026-11-20T04:03:18.620Z}]");
  });
});
