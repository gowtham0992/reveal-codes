    expect(s?.files\[0\]?.counts).toEqual({ AI: 0, "AI>HUM": 0, HUM: 0, PST: 20 });
    expect(s?.total).toEqual({ AI: 17, "AI>HUM": 3, HUM: 5, PST: 23 });
    expect(s?.totalCharacters).toBe(48);
    expect(out.[AI:7.10 Summary order, file filter, `--all`, aligned columns, no repeated titles 2026-11-20T05:17:25Z.1{t=2026-11-20T05:24:04.007Z}]lines\[0\]).toBe(
