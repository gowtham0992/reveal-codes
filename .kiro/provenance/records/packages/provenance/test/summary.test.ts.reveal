    );
    expect(out.text).toContain("[AI:7.10 Summary order, file filter, `--all`, aligned columns, no repeated titles 2026-11-20T05:17:25Z.5{t=2026-11-20T05:24:04.007Z}]  written in turn  opened 2026-11-19T10:05:00Z[AI:7.5 `summary.ts` 2026-11-20T04:03:24Z.1{t=2026-11-20T04:07:25.429Z}]");
