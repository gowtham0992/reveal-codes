    expect(summarize(base({ records: \[a\], path: "src/b.ts", sessions: 7 })).text).toContain(
      noPromptSessionsLine(7),
    [AI:7.10 Summary order, file filter, `--all`, aligned columns, no repeated titles 2026-11-20T05:17:25Z.7{t=2026-11-20T05:24:04.007Z}]);
