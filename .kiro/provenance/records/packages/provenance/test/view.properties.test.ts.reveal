[AI:7.4 Property 6: colour output is the plain output with the colour removed 2026-11-20T04:07:29Z.1{t=2026-11-20T04:10:47.277Z}]import { viewRecord } from "../src/core/view.js";
import { arbPath, arbViewDocument } from "../src/testing/arbitraries.js";
import { runs } from "./support/fc.js";

/** Header line plus the four legend lines. */
const [AI:7.11 Short run tags, "Runs in this file", `--full` 2026-11-20T05:24:08Z.3{t=2026-11-20T05:35:16.652Z}]LEGEND_LINES = 5;
/** The tags sentence and the heading of the Runs list. */
const LIST_LINES = 2[AI:7.4 Property 6: colour output is the plain output with the colour removed 2026-11-20T04:07:29Z.1{t=2026-11-20T04:10:47.277Z}];
const arbColourMode = fc.constantFrom("truecolor" as const, "ansi256" as const);

/** Every ANSI sequence the viewer prints[AI:7.12 Solid pane in colour mode 2026-11-20T05:35:20Z.1{t=2026-11-20T05:38:00.254Z}]: `ESC \[ digits and semicolons m`, or the erase `ESC \[ K[AI:7.4 Property 6: colour output is the plain output with the colour removed 2026-11-20T04:07:29Z.1{t=2026-11-20T04:10:47.277Z}]`. */
// eslint-disable-next-line no-control-regex
const ANSI = /\\u001b\\\[\[0-9;\]*[AI:7.12 Solid pane in colour mode 2026-11-20T05:35:20Z.2{t=2026-11-20T05:38:00.254Z}]\[mK\][AI:7.4 Property 6: colour output is the plain output with the colour removed 2026-11-20T04:07:29Z.1{t=2026-11-20T04:10:47.277Z}]/g;
const stripAnsi = (s: string): string => s.replace(ANSI, "");

/** The control-character pictures, written out here and not read from `neutralize.ts`. */
function expectedPictures(text: string): string {
  let out = "";
  for (const ch of text) {
    const u = ch.charCodeAt(0);
    if (ch.length === 1 && u < 0x20 && u !== 0x0a && u !== 0x09)
      out += String.fromCharCode(0x2400 + u);
    else if (u === 0x7f) out += "\\u2421";
    else if (ch.length === 1 && u >= 0x80 && u <= 0x9f) out += "\\ufffd";
    else out += ch;
  }
  return out;
}

type Scanned = { kept: string; text: string; codes: string\[\] };

/**
 * Reads a plain body: `\\x` is the character `x`; an unescaped `\[` opens a code that
 * ends at the next unescaped `\]`. `kept` is the body with escapes removed from text only.
 */
function scanBody(body: string): Scanned {
  const out: Scanned = { kept: "", text: "", codes: \[\] };
  let i = 0;
  while (i < body.length) {
    const ch = body.charAt(i);
    if (ch === "\\\\") {
      const next = body.charAt(i + 1);
      out.kept += next;
      out.text += next;
      i += 2;
    } else if (ch === "\[") {
      let j = i + 1;
      while (j < body.length && body.charAt(j) !== "\]") j += body.charAt(j) === "\\\\" ? 2 : 1;
      const code = body.slice(i, j + 1);
      out.kept += code;
      out.codes.push(code);
      i = j + 1;
    } else {
      out.kept += ch;
      out.text += ch;
      i += 1;
    }
  }
  return out;
}

[AI:7.11 Short run tags, "Runs in this file", `--full` 2026-11-20T05:24:08Z.4{t=2026-11-20T05:35:16.652Z}]const arbWindowRun: fc.Arbitrary<string> = fc
  .tuple(
    fc.constantFrom("", "6.6 ", "6.6 ", "7 ", "12.1 "),
    fc.constantFrom("turn", "task", "Wire it", "A\[b\]\\\\c", "x ~2"),
    fc.constantFrom("10:00:00Z", "10:00:00Z", "10:05:00Z", "09:59:59Z"),
    fc.constantFrom("", "~2"),
  )
  .map((\[number, title, time, suffix\]) => `${number}${title} 2026-11-19T${time}${suffix}`);

/** `doc` with every agent span moved into one of `windows`, so that windows clash on tags. */
function intoWindows(
  doc: Document,
  windows: readonly string\[\],
  picks: readonly number\[\],
): Document {
  let n = 0;
  const spans = doc.spans.map((span) => {
    const p = span.provenance;
    if (p.origin !== "AI" && p.origin !== "AI>HUM") return span;
    const window = windows\[(picks\[n\] ?? 0) % windows.length\] ?? "";
    n += 1;
    return { ...span, provenance: { ...p, runId: `${window}.${String(1 + (n % 3))}` } };
  });
  return { ...doc, spans };
}

/** The window of a Run_Id, written out here and not read from `tags.ts`. */
const windowOf = (runId: string): string => runId.replace(/\\.\\d+$/u, "");

function agentRuns(doc: Document): string\[\] {
  return doc.spans.flatMap((s) =>
    s.provenance.origin === "AI" || s.provenance.origin === "AI>HUM"
      ? \[s.provenance.runId ?? ""\]
      : \[\],
  );
}

function expectTagsConsistent(codes: readonly string\[\], doc: Document): void {
  const tagOf = new Map<string, string>();
  const spans = doc.spans.filter(
    (s) => s.provenance.origin === "AI" || s.provenance.origin === "AI>HUM",
  );
  codes
    .filter((c) => c.startsWith("\[AI"))
    .forEach((code, i) => {
      const tag = /^\\\[AI(?:>HUM)?:(.*)\\\]$/u.exec(code)?.\[1\] ?? "";
      const run = spans\[i\]?.provenance.runId ?? "";
      expect(tag).toMatch(/^(\\d+(\\.\\d+)*|turn|task)(~\[2-9\]\\d*)?$/u);
      expect(tagOf.get(windowOf(run)) ?? tag).toBe(tag);
      tagOf.set(windowOf(run), tag);
    });
  const tags = \[...tagOf.values()\];
  expect(new Set(tags).size).toBe(tags.length);
  for (const tag of tags) {
    const \[base = "", k\] = tag.split("~");
    for (let j = 2; j < Number(k ?? 1); j += 1) expect(tags).toContain(`${base}~${String(j)}`);
    if (k !== undefined) expect(tags).toContain(base);
  }
}

