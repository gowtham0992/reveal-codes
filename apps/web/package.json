{
  "name": "@reveal-codes/web",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js editor with the Reveal Codes pane.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "predev": "node --import jiti/register scripts/copy-demo.ts",
    "dev": "next dev --port 3000 --webpack",
    "prebuild": "node --import jiti/register scripts/copy-demo.ts",
    "build": "tsc -b ../../packages/engine ../../packages/verifier ../../packages/export && next build --webpack",
    "start": "next start --port 3000"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.135",
    "@ai-sdk/anthropic": "4.0.99",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/libre-caslon-text": "5.3.0",
    "@fontsource/public-sans": "5.3.0",
    "@reveal-codes/engine": "workspace:*",
    "@reveal-codes/export": "workspace:*",
    "@reveal-codes/verifier": "workspace:*",
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-document": "3.33.0",
    "@tiptap/extension-paragraph": "3.33.0",
    "@tiptap/extension-text": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@vercel/oidc-aws-credentials-provider": "3.3.20",
    "ai": "7.0.165",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fast-check": "4.10.2",
    "fflate": "0.8.3",
    "jsdom": "28.1.0"
  }
}
